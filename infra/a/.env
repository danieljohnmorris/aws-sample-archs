# Local emulator values only. Every secret here is a throwaway that reaches floci on this machine and nothing else.
# Never point these at a real AWS account.
COMPOSE_PROJECT_NAME=ftw-a
FLOCI_PORT=4566
RDS_PORTS=7001-7010
RDS_BASE=7001
RDS_MAX=7010
ALB_PORTS=8080-8089
FLOCI_NET=ftw-a_default
IAM_ENFORCEMENT=false
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
CDK_DEFAULT_ACCOUNT=000000000000
CDK_DEFAULT_REGION=eu-west-2

# Signing key for POST /webhooks/payment. The CDK app writes this exact
# value into Secrets Manager and the end-to-end test signs with it, so both
# sides agree. Local fixture for a throwaway emulator, not a real key.
PAYMENT_WEBHOOK_SECRET=89cc835523bd77957d0c2faafcbbdf5ffa7a8c99608739366ddc6c6f5c68ab49

# Postgres password for both instances. floci hands a Lambda or an ECS task
# the literal {{resolve:secretsmanager:...}} string instead of the value, so
# DATABASE_URL has to carry the password and every stack has to agree on it.
# Alphanumeric so it needs no escaping inside a URL.
DB_PASSWORD=YlqPJGCJpsrZSVsvZ12nz597higT172r
